					AddDate = Table.AddColumn(Typed, "Date", each #date([Year], [Month], 1), type date),
					Result = Table.SelectColumns(AddDate, {"RegionKey", "CategoryKey", "SegmentKey", "Date", "Sales", "Profit", "Delivered Orders", "Units Sold", "All Orders"})
				in
					Result

